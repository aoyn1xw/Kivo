<Application x:Class="Kivo.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppBackground" Color="#090B0F" />
            <SolidColorBrush x:Key="Surface" Color="#11151B" />
            <SolidColorBrush x:Key="ElevatedSurface" Color="#141820" />
            <SolidColorBrush x:Key="BorderColor" Color="#252B35" />
            <SolidColorBrush x:Key="PrimaryText" Color="#F2F4F8" />
            <SolidColorBrush x:Key="SecondaryText" Color="#929BAA" />
            <Color x:Key="SystemAccentColor">#4D8EFF</Color>
            <Color x:Key="SystemAccentColorLight1">#82ADFF</Color>
            <Color x:Key="SystemAccentColorLight2">#82ADFF</Color>
            <Color x:Key="SystemAccentColorLight3">#82ADFF</Color>
            <Color x:Key="SystemAccentColorDark1">#4D8EFF</Color>
            <Color x:Key="SystemAccentColorDark2">#4D8EFF</Color>
            <Color x:Key="SystemAccentColorDark3">#4D8EFF</Color>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#090B0F" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#090B0F" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#4D8EFF" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#4D8EFF" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4D8EFF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#82ADFF" />
            <FontFamily x:Key="UIFont">IBM Plex Sans, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
